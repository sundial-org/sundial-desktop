package-lock.json
.claude
# Stray LaTeX build artifacts that compile-checks may produce inside
# templates/<x>/files/. The registry filters these at read-time, but keep
# them out of git too.
templates/**/files/*.aux
templates/**/files/*.fdb_latexmk
templates/**/files/*.fls
templates/**/files/*.log
templates/**/files/*.out
templates/**/files/*.toc
templates/**/files/*.synctex.gz
templates/**/files/*.bbl
templates/**/files/*.blg

# reliability harness local artifacts
reliability/artifacts/

CLAUDE.local.md
agent-ts/eval/harness-quality-runs/
mcp/eval/metrics.jsonl

# entire.io session-capture CLI (personal tooling, config stays local)
.entire/

# desktop-ui build output (root patterns are anchored)
desktop-ui/.next/
desktop-ui/out/
