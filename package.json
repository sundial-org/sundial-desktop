    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.9.3",
    "sharp": "^0.34.5",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "use-stick-to-bottom": "^1.1.4",
