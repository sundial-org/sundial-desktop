{
  "name": "sundial-v2",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev/next-dev.mjs run",
    "dev:webpack": "node scripts/dev/next-dev.mjs run --webpack",
    "dev:status": "node scripts/dev/next-dev.mjs status",
    "dev:prune": "node scripts/dev/next-dev.mjs prune",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "test": "node scripts/dev/test-gate.mjs",
    "test:changed": "node scripts/dev/test-gate.mjs --changed=origin/dev",
    "test:unit:web": "vitest run",
    "test:unit:agent": "pnpm -C agent-ts test",
    "test:unit:python": "PYTHONPATH=. python3.11 -m unittest discover -s tests -p \"*_test.py\" -t .",
    "test:sql": "psql \"${GREP_TEST_DB_URL:-postgresql://postgres:postgres@localhost:5432/postgres}\" -v ON_ERROR_STOP=1 -f tests/sql/grep_workspace_test.sql",
    "browser:smoke": "playwright test tests/smoke",
    "e2e:live": "playwright test tests/runtime --workers=4",
    "e2e:modal": "vitest run --config vitest.e2e-modal.config.ts",
    "health:fly-agent": "python3.11 scripts/ci/fly_agent_smoke.py",
    "test:smoke": "pnpm browser:smoke",
    "test:e2e-modal": "pnpm e2e:modal",
    "test:runtime": "pnpm e2e:live",
    "test:rls": "supabase db query --linked --file supabase/tests/rls_policies.sql > /dev/null && echo '✓ RLS policy tests passed'",
    "test:security:posture": "supabase db query --linked --file supabase/tests/security_posture.sql > /dev/null && echo '✓ security posture snapshots passed'",
    "test:security:advisor": "node scripts/dev/check-advisor.mjs",
    "test:security": "pnpm test:rls && pnpm test:security:posture && pnpm test:security:advisor",
    "test:all": "pnpm test && pnpm test:unit:agent && pnpm test:unit:python && pnpm browser:smoke && pnpm e2e:live && pnpm e2e:modal",
    "linq:route": "node scripts/dev/linq-route.mjs",
    "linq:unroute": "node scripts/dev/linq-route.mjs --remove",
    "brain:smoke": "node scripts/dev/brain-smoke.mjs",
    "pr-visuals:upload": "tsx scripts/dev/upload-pr-visuals.ts",
    "smoke:upload-large": "tsx scripts/dev/upload-smoke-large.ts",
    "local:server": "node local-server/server.mjs"
  },
  "dependencies": {
