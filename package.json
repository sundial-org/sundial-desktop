    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0-preview.5",
    "playwright": "^1.58.2",
    "prosemirror-model": "^1.25.7",
    "prosemirror-state": "^1.4.4",
    "supabase": "^2.98.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "comment": "Force ONE copy of each core prosemirror package across the whole tree. Tiptap v3's @tiptap/pm needs view ^1.41.8 / transform ^1.12.0, but transitive deps (prosemirror-inputrules/-keymap) pull an older prosemirror-model, so two Fragment classes coexist and instanceof fails — the 'Can not convert <> to a Fragment (looks like multiple versions of prosemirror-model were loaded)' crash. Deduping model/state here too keeps our bare prosemirror-* imports on the same copy as the editor.",
    "overrides": {
      "prosemirror-model": "^1.25.9",
      "prosemirror-state": "^1.4.4",
      "prosemirror-view": "^1.41.8",
      "prosemirror-transform": "^1.12.0"
    }
  }
}
